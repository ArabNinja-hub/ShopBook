# ShopBook Server Configuration (.env.example)
# Copy to .env for local overrides. Never commit real .env files to Git.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# PostgreSQL Connection String:
# - Production / Render / Docker / Neon:
#     DATABASE_URL=postgresql://shopbook_user:STRONG_PASSWORD@host:5432/shopbook
# - Zero-cost local development (default when omitted in NODE_ENV=development):
#     DATABASE_URL=pglite://.local-pgdata
DATABASE_URL=pglite://.local-pgdata
DATABASE_SSL=false

# Session & Cookie Security
SESSION_COOKIE_NAME=sb_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto
TRUST_PROXY=true

# Optional comma-separated origins if frontend is hosted on a separate origin from the API
CORS_ALLOWED_ORIGINS=

# Serve compiled ./dist SPA assets directly from Fastify in single-service deployments
SERVE_STATIC_DIST=false

# Free Pilot & Future Entitlement Flags
# Pilot shops receive unrestricted access without payment prompts.
DEFAULT_PILOT_EXEMPT=true
ENFORCE_SUBSCRIPTIONS=false

LOG_LEVEL=info
