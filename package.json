{
  "name": "shopbook",
  "version": "0.1.0",
  "private": true,
  "description": "ShopBook — Mobile-first sales, stock, and customer credit-book web app for small shops in Zambia",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/cli/migrateCli.ts",
    "admin:issue-reset": "tsx server/cli/issuePasswordReset.ts",
    "build": "npm run typecheck && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "verify:dist": "node scripts/verify-dist-base.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
